          "id": "6199271b-bcb3-458e-b97c-dab78069186b",
          "name": "Get results for all documents in a parser",
          "request": {
            "name": "Get results for all documents in a parser",
            "description": {
              "content": "Retrieves parsed data for multiple documents belonging to the specified parser. Supports filtering, sorting, and pagination. Rate limited to 30 calls per minute.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "results",
                ":parserId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "format",
                  "value": "object",
                  "description": "Output format for parsed results. \"object\" (recommended) returns structured JSON; \"flat\" returns a flat key-value map."
                },
                {
                  "disabled": false,
                  "key": "list",
                  "value": "<string>",
                  "description": "Filter documents by list type."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of results to return."
                },
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<dateTime>",
                  "description": "Filter results to documents processed after this date (ISO 8601)."
                },
                {
                  "disabled": false,
                  "key": "remote_id",
                  "value": "<string>",
                  "description": "Filter results by remote_id assigned at upload."
                },
                {
                  "disabled": false,
                  "key": "include_processing_queue",
                  "value": "false",
                  "description": "Include documents still in the processing queue."
                },
                {
                  "disabled": false,
                  "key": "sort_by",
                  "value": "<string>",
                  "description": "Field to sort results by."
                },
                {
                  "disabled": false,
                  "key": "sort_order",
                  "value": "desc",
                  "description": "Sort order for results."
