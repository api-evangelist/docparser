          "id": "1a2b4782-035c-47c8-a34f-4092a771f14d",
          "name": "Upload a document by file",
          "request": {
            "name": "Upload a document by file",
            "description": {
              "content": "Uploads a document to the specified parser using multipart form data (file upload) or base64-encoded content. The document is queued for parsing immediately upon upload.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "document",
                "upload",
                ":parserId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "parserId",
                  "description": "(Required) The unique identifier of the document parser."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The document file to upload (PDF, DOCX, image)."
                },
                {
                  "key": "file_name",
                  "value": "<string>",
                  "type": "text",
                  "description": "Optional filename override. If not provided, the original filename is used."
                },
                {
                  "key": "remote_id",
                  "value": "<string>",
                  "type": "text",
                  "description": "Optional custom identifier to associate with the document for tracking purposes."
                }
              ]
            }
