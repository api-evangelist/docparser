{
  "info": {
    "_postman_id": "f149bcb2-b0f4-42b7-8945-2365d77dcc0c",
    "name": "Docparser REST Documents Results API",
    "description": "The Docparser REST API provides programmatic access to document parsing and data extraction capabilities. Developers can upload documents via file upload, base64 encoding, or public URL fetch, retrieve parsed results for individual or multiple documents, manage parser configurations, and trigger re-parsing or re-integration operations. The API uses HTTP Basic Auth with the API key as the username and enforces per-minute rate limits on result retrieval endpoints.\n\nContact Support:\n Name: Docparser Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:31:33.000Z",
    "updatedAt": "2026-07-28T01:31:33.000Z",
    "lastUpdatedBy": "35240",
