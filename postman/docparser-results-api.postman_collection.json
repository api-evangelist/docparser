              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/results/:parserId?format=object&list=last_processed&limit=100&date=<dateTime>&remote_id=<string>&include_processing_queue=false&sort_by=uploaded_at&sort_order=desc",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "results",
                    ":parserId"
                  ],
                  "query": [
                    {
                      "description": "Output format for parsed results. \"object\" (recommended) returns structured JSON; \"flat\" returns a flat key-value map.",
                      "key": "format",
                      "value": "object"
                    },
                    {
                      "description": "Filter documents by list type.",
                      "key": "list",
                      "value": "last_processed"
                    },
                    {
                      "description": "Maximum number of results to return.",
                      "key": "limit",
                      "value": "100"
                    },
                    {
                      "description": "Filter results to documents processed after this date (ISO 8601).",
                      "key": "date",
                      "value": "<dateTime>"
                    },
                    {
                      "description": "Filter results by remote_id assigned at upload.",
                      "key": "remote_id",
                      "value": "<string>"
                    },
                    {
                      "description": "Include documents still in the processing queue.",
                      "key": "include_processing_queue",
                      "value": "false"
                    },
                    {
                      "description": "Field to sort results by.",
                      "key": "sort_by",
                      "value": "uploaded_at"
                    },
                    {
                      "description": "Sort order for results.",
                      "key": "sort_order",
                      "value": "desc"
