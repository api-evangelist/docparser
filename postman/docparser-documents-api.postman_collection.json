                        "value": "multipart/form-data"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "formdata",
                      "formdata": [
                        {
                          "description": "(Required) The document file to upload (PDF, DOCX, image).",
                          "key": "file",
                          "type": "file",
                          "value": null
                        },
                        {
